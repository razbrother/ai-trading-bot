[Unit]
Description=AI Trading Bot
After=network-online.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/ai-trading-bot
EnvironmentFile=/home/ubuntu/ai-trading-bot/.env
ExecStart=/home/ubuntu/ai-trading-bot/.venv/bin/python -m app.main --mode live --market-source groww --news-source none --history-source groww
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
