AI_MAX_ENTRY_DIFF_PCT=0.20
AI_MAX_STOP_DIFF_ATR=0.30
AI_MAX_TARGET_DIFF_ATR=0.50
AI_REQUIRE_CONSENSUS=true

GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=
GROWW_API_KEY=
GROWW_API_SECRET=

SYMBOLS=RELIANCE:2885,TCS:11536,INFY:1594,SBIN:3045,ICICIBANK:4963
STARTING_CAPITAL=25000
MAX_RISK_PER_TRADE_PCT=0.005
MAX_DAILY_LOSS=250
HARD_DAILY_PROFIT=400
MAX_POSITION_VALUE=10000
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=2
MIN_REWARD_RISK=1.5
MIN_TECHNICAL_SCORE=75
MAX_SPREAD_PCT=0.15
MAX_SIGNAL_AGE_SECONDS=90
MIN_STOP_ATR_MULTIPLE=0.5
MAX_STOP_ATR_MULTIPLE=1.5

ENTRY_START=09:25
LAST_ENTRY=14:45
FORCE_EXIT=15:10
SCAN_INTERVAL_SECONDS=300
POSITION_CHECK_SECONDS=5
RECONCILE_INTERVAL_SECONDS=30
PAPER_SLIPPAGE_BPS=5
