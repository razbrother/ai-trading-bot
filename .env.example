TRADING_MODE=PAPER
LIVE_TRADING_UNLOCK=false
LIVE_ACK=
AUTO_START=false
DATABASE_PATH=data/trading.db
TIMEZONE=Asia/Kolkata

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

GEMINI_API_KEY=
