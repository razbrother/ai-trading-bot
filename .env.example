LIVE_COST_BPS=20
GROWW_INDICATOR_CACHE_SECONDS=60
GROWW_INDICATOR_CANDLE_DAYS=5


# Runtime source policy. CLI arguments override these defaults.
MARKET_SOURCE=mock
NEWS_SOURCE=none
HISTORY_SOURCE=groww
REQUIRE_NEWS_FOR_ENTRY=false
REQUIRE_HISTORY_FOR_ENTRY=true
MIN_HISTORY_CANDLES=100
MAX_NEWS_AGE_MINUTES=60
MAX_MARKET_DATA_AGE_SECONDS=15
ALLOW_MOCK_PAPER_ONLY=true

TOP_CANDIDATES=5
APP_VERSION=2.0.0
TELEGRAM_CONFIRM_TIMEOUT_SECONDS=30
REQUIRE_LIVE_HEALTH_PASS=true
REQUIRE_TELEGRAM_USER_LOCK_IN_LIVE=true


LIVE_ORDER_MAX_QTY=1
LIVE_PROBE_SYMBOL=WIPRO
LIVE_PROBE_PRICE=1
LIVE_PROBE_ENABLE_ORDER_TEST=false
LIVE_ORDER_TIMEOUT_SECONDS=25
LIVE_ORDER_POLL_SECONDS=2
LIVE_CANCEL_ON_TIMEOUT=true
LIVE_REQUIRE_MARGIN_CHECK=true
LIVE_REQUIRE_BROKER_STOP=true
LIVE_REQUIRE_STARTUP_RECONCILIATION=true
SINGLE_INSTANCE_LOCK=/tmp/ai-trading-bot.lock

NEWS_SOURCE=gdelt
GDELT_CACHE_SECONDS=300
GDELT_MIN_REQUEST_INTERVAL_SECONDS=10
GDELT_TIMESPAN=1h
GDELT_MAX_RECORDS=75
GDELT_TIMEOUT_SECONDS=15
